# --- Required ---------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string

# --- First admin (used only when the database has no users yet) -------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-10-chars
ADMIN_ORG=gensci

# --- One-time import of the spreadsheet mounted from ./resources ------------
INITIAL_IMPORT_PATH=/import/Master Track Sheet-GS098.xlsx
INITIAL_IMPORT_OVERRIDES={"owner": {"formulation": "gensci"}}

# --- Where the app is reached (used in invitation links) --------------------
APP_ORIGIN=http://localhost:8000
APP_PORT=8000

# --- Database: SQLite on the app-data volume by default ---------------------
DATABASE_URL=sqlite:////data/app.db

# --- Behaviour ---------------------------------------------------------------
SESSION_TTL_HOURS=72
INVITE_TTL_DAYS=7
# Default lifetime of an API token, in days. Pass --ttl-days 0 to a single token
# (admins only) for one that never expires.
MCP_TOKEN_TTL_DAYS=90
# Serve the MCP endpoint at /mcp so agents can read the tracker. Bearer API
# tokens only; the session cookie is deliberately not accepted there.
MCP_ENABLED=true
# Comma-separated Host allowlist for /mcp. Empty disables host checking, which
# is safe because the endpoint takes no ambient credential.
MCP_ALLOWED_HOSTS=
# Kill switch: false makes /mcp read-only without revoking any token.
MCP_WRITES_ENABLED=true
# Per-token budgets, per minute. Per process; the container runs one worker.
MCP_RATE_READS_PER_MIN=600
MCP_RATE_WRITES_PER_MIN=60
# How long a retried cmc_create_item with the same idempotency key replays the original.
IDEMPOTENCY_TTL_HOURS=24
# Write mode for a new token when none is chosen: interactive (edits need confirming)
# or append (post updates and file items only; for agents nobody is watching).
MCP_DEFAULT_WRITE_MODE=interactive
DUE_SOON_DAYS=14
STALE_DAYS=14
LOG_LEVEL=info

# --- Image source (registry or tarball); unset = locally built image --------
# IMAGE=ghcr.io/<owner>/<repo>
# APP_VERSION=latest

# --- PostgreSQL profile (docker compose --profile postgres up -d) -----------
# Point the app at the postgres service and set a password; the same migrations apply.
# DATABASE_URL=postgresql+psycopg://cmc:change-me@postgres:5432/cmc
# POSTGRES_USER=cmc
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=cmc

# --- HTTPS proxy profile (docker compose --profile proxy up -d) -------------
# Caddy obtains and renews certificates for DOMAIN automatically.
# DOMAIN=tracker.example.com
# When using the proxy, set APP_ORIGIN to the https URL:
# APP_ORIGIN=https://tracker.example.com
