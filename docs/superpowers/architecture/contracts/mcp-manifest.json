                "title": "Due On"
              },
              "priority": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "p1, p2, p3; empty clears",
                "title": "Priority"
              },
              "category": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "empty string clears",
                "title": "Category"
              },
              "assignee_id": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "0 unassigns",
                "title": "Assignee Id"
              },
              "details": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Details"
              },
              "notes_risks": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Notes Risks"
              },
              "file_path": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "File Path"
              },
              "post": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
